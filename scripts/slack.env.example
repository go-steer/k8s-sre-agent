# Copy to scripts/slack.env to point the demo at a real Slack workspace.
# slack.env is gitignored; this file is the shape, with no values in it.
#
# Its presence is the whole switch: with it, monitor.sh starts switchboard and
# digests land in the channel below. Without it, monitor.sh starts
# tools/fake-ingress and prints them to the terminal instead.

# Socket Mode app-level token, from Basic Information → App-Level Tokens, with
# the connections:write scope. Outbound-only deployments still need this:
# `switchboard serve` dials Socket Mode before it will serve the ingress, and
# exits when that connection stops. See go-steer/switchboard#23.
SWITCHBOARD_SLACK_APP_TOKEN=xapp-...

# Bot user OAuth token, from OAuth & Permissions. chat:write is the only scope
# posting needs.
SWITCHBOARD_SLACK_BOT_TOKEN=xoxb-...

# The channel digests go to, as an ID rather than a name — Slack's API takes
# the ID, and so does switchboard's --ingress-allow. Find it under View channel
# details, at the bottom. Invite the bot first: /invite @switchboard
SLACK_CONVERSATION=C0123ABCD
